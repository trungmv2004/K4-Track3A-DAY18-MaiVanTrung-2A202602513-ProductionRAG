# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto
# For processing entirely on this machine: offline (extractive), or local (LLM server).
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5:3b
# Defaults match the assignment. Models are cached inside .cache/models/.
LLM_MODEL=
GEMINI_MODEL=gemini-3.5-flash-lite
# Observed free-tier quota is 15 chat requests/minute; leave one request of margin.
GEMINI_REQUESTS_PER_MINUTE=14
EVAL_EMBEDDING_MODEL=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_HOST=localhost
QDRANT_PORT=6333
